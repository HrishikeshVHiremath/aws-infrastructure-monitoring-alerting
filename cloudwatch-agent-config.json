
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root",
    "debug": false
  },
  "metrics": {
    "namespace": "CloudMonitoringProject",
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
